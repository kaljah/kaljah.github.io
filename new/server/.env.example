# ===================================================
# Flask Backend Configuration Template (.env.example)
# Copy this file to .env and configure your variables
# ===================================================

# Environment mode: 'development' or 'production'
FLASK_ENV=development

# Application Secret Key (generate a strong random string in production)
# Leave empty for local development (a built-in dev key is used with a warning).
# Production refuses to start without a real value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Database Type: 'sqlite' or 'postgres'
DB_TYPE=sqlite

# Database URL (required if DB_TYPE=postgres, optional for sqlite)
# SQLite default: sqlite:///ghg_app.db
# PostgreSQL example: postgresql://user:password@localhost:5432/ghg_db
DATABASE_URL=sqlite:///ghg_app.db

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173

# ===================================================
# Admin Account Seeding (SECURITY CRITICAL)
# ===================================================
# Set SEED_ADMIN=true ONLY during initial setup, then remove or set to false.
# NEVER commit .env with SEED_ADMIN=true to version control.
# In production, ADMIN_PASSWORD must NOT be a known-weak value.
SEED_ADMIN=false
ADMIN_EMAIL=your-admin@company.com
ADMIN_PASSWORD=CHANGEME_use_a_strong_unique_password_here
ADMIN_FULL_NAME=System Administrator

# Optional IT admin account
# IT_ADMIN_EMAIL=it-admin@company.com
# IT_ADMIN_PASSWORD=CHANGEME_strong_password

# ===================================================
# Rate Limiting
# ===================================================
RATELIMIT_DEFAULT=200 per minute
# Production needs a shared store so every worker counts together (requires Redis):
# REDIS_URL=redis://localhost:6379/0
# Single-worker production only, to run without Redis:
# ALLOW_MEMORY_LIMITER=true

# ===================================================
# CORS
# ===================================================
# In production list every allowed origin explicitly ('*' is rejected). Only these origins are allowed.

