{
  "openapi": "3.0.0",
  "info": {
    "title": "GHG Platform API",
    "description": "API documentation and health checking portal for the Greenhouse Gas (GHG) Platform backend.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Server (Relative Path)"
    },
    {
      "url": "http://localhost:5000",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Check API Health Status",
        "description": "Returns the operational status of the server and API version.",
        "responses": {
          "200": {
            "description": "API is healthy and running.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "version": {
                      "type": "string",
                      "example": "1.0.0"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "User Login",
        "description": "Authenticate user using email and password, establishing a session.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "admin@example.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "example": "securepassword123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Login successful"
                    },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "integer", "example": 1 },
                        "fullName": { "type": "string", "example": "John Doe" },
                        "email": { "type": "string", "example": "admin@example.com" },
                        "role": { "type": "string", "example": "it_admin" },
                        "orgName": { "type": "string", "example": "ACME Corp" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials."
          },
          "429": {
            "description": "Too many login attempts."
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Get Current User Details",
        "description": "Returns profile information of the currently logged-in user session.",
        "responses": {
          "200": {
            "description": "User details successfully retrieved.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer", "example": 1 },
                    "fullName": { "type": "string", "example": "John Doe" },
                    "email": { "type": "string", "example": "admin@example.com" },
                    "role": { "type": "string", "example": "it_admin" },
                    "orgName": { "type": "string", "example": "ACME Corp" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated."
          }
        }
      }
    }
  }
}
