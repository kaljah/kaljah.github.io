# Configuration for the GHG platform. install.sh copies this to /etc/ghg/ghg.env (mode 600) and fills SECRET_KEY.
# Plain KEY=value lines, no quotes, no spaces around "=". Percent-encode special characters in URLs
# (for example "@" in a password is %40).

FLASK_ENV=production

# Filled in by install.sh. Never reuse it elsewhere; changing it signs everyone out.
SECRET_KEY=

# PostgreSQL provided by Sonatrach IT. The user needs to create tables (schema migrations run on upgrade).
DB_TYPE=postgres
DATABASE_URL=postgresql://ghg:CHANGE_ME@db.example.local:5432/ghg

# The address users type in the browser. Same origin as the site (nginx serves both).
ALLOWED_ORIGINS=https://ghg.example.local
CORS_STRICT=true
SESSION_COOKIE_SAMESITE=Lax

# Rate limits. One gunicorn worker uses in-memory counters. For more than one worker install Redis,
# set REDIS_URL, remove ALLOW_MEMORY_LIMITER and raise GUNICORN_WORKERS.
ALLOW_MEMORY_LIMITER=true
# REDIS_URL=redis://127.0.0.1:6379/0
GUNICORN_WORKERS=1
GUNICORN_THREADS=8

# Upgrades run "flask db upgrade" explicitly (upgrade.sh); the app must not change the schema by itself.
AUTO_MIGRATE=false

# Largest upload in bytes (default 50 MB). Keep nginx client_max_body_size in step with it.
# MAX_CONTENT_LENGTH=52428800

SEED_ADMIN=false
