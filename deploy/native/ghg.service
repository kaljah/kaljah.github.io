[Unit]
Description=GHG accounting platform (gunicorn)
After=network.target

[Service]
Type=simple
User=ghg
Group=ghg
WorkingDirectory=/opt/ghg/server
EnvironmentFile=/etc/ghg/ghg.env
Environment=FLASK_APP=app.py
ExecStart=/opt/ghg/venv/bin/gunicorn \
    --bind 127.0.0.1:5000 \
    --workers ${GUNICORN_WORKERS} \
    --threads ${GUNICORN_THREADS} \
    --timeout 120 \
    --access-logfile - \
    --error-logfile - \
    app:app
Restart=on-failure
RestartSec=5

# Hardening: the service can only write to its data directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ghg

[Install]
WantedBy=multi-user.target
