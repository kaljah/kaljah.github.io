[Unit]
Description=Neocarbon GHG accounting API (gunicorn)
After=network-online.target postgresql.service redis.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=neocarbon
Group=neocarbon
WorkingDirectory=/opt/neocarbon/server
EnvironmentFile=/etc/neocarbon/neocarbon.env
Environment=PATH=/opt/neocarbon/venv/bin:/usr/bin:/bin
# Database migrations first; the app refuses to start on a database behind the code.
ExecStartPre=/opt/neocarbon/venv/bin/flask db upgrade
ExecStart=/opt/neocarbon/venv/bin/gunicorn -c /opt/neocarbon/gunicorn.conf.py app:app
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=40

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/neocarbon /var/backups/neocarbon
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
