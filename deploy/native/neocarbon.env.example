# Neocarbon settings for a native install: /etc/neocarbon/neocarbon.env (owner root, group
# neocarbon, mode 640). Every setting is described in docs/deployment.md.

FLASK_ENV=production
DB_TYPE=postgres
# postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0
# Long random value: openssl rand -hex 32
SECRET_KEY=
# https:// followed by the host name users type in the browser
ALLOWED_ORIGINS=
# nginx runs in front of gunicorn
TRUSTED_PROXIES=1
GUNICORN_BIND=127.0.0.1:8000
UPLOAD_JOB_DIR=/var/lib/neocarbon/upload_jobs
# Empty: logs go to the journal (journalctl -u neocarbon)
LOG_FILE=
# matplotlib (PDF charts) needs a writable cache folder
MPLCONFIGDIR=/var/lib/neocarbon/matplotlib
BACKUP_DIR=/var/backups/neocarbon
BACKUP_RETAIN_COUNT=14

# First start only: accounts created by `neocarbon-seed-admin` (see docs/deployment.md)
ADMIN_EMAIL=
ADMIN_PASSWORD=
IT_ADMIN_EMAIL=
IT_ADMIN_PASSWORD=

# Optional (defaults shown)
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=4
# MAX_CONTENT_LENGTH=52428800
# MAX_CONCURRENT_UPLOADS_PER_USER=3
# LOGIN_RATE_LIMIT=50 per 15 minutes
# LOGIN_ACCOUNT_LIMIT=10 per 15 minutes
# MAP_TILE_URL=
# MAP_TILE_ATTRIBUTION=
# MAP_TILE_SUBDOMAINS=
# DISABLE_OUTBOUND_EMAIL=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# EMAIL_FROM=
