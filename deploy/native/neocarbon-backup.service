[Unit]
Description=Neocarbon database backup
After=postgresql.service

[Service]
Type=oneshot
User=neocarbon
Group=neocarbon
WorkingDirectory=/opt/neocarbon/server
EnvironmentFile=/etc/neocarbon/neocarbon.env
ExecStart=/opt/neocarbon/venv/bin/python scripts/backup.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/neocarbon
