# Neocarbon settings for deploy/compose.yml. Copy to .env and fill in; keep .env readable by
# root only (chmod 600 .env). Every setting is described in docs/deployment.md.

# --- Required -----------------------------------------------------------------------------
# Host name users type in the browser (must match the TLS certificate)
SERVER_NAME=
# Long random value, e.g. the output of: openssl rand -hex 32
SECRET_KEY=
# Database password, e.g. the output of: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- First start: accounts created by `docker compose run --rm app seed-admin` -------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
IT_ADMIN_EMAIL=
IT_ADMIN_PASSWORD=

# --- Optional -----------------------------------------------------------------------------
# Image version to run (set by the release bundle)
NEOCARBON_VERSION=latest
# Registry holding the postgres / redis / base images when building or pulling
# REGISTRY=docker.io/library
# Folder with fullchain.pem and privkey.pem
# TLS_DIR=./certs
# HTTP_PORT=80
# HTTPS_PORT=443
# POSTGRES_DB=neocarbon
# POSTGRES_USER=neocarbon
# BACKUP_RETAIN_COUNT=14
# MAX_CONTENT_LENGTH=52428800
# MAX_CONCURRENT_UPLOADS_PER_USER=3
# LOGIN_RATE_LIMIT=50 per 15 minutes
# LOGIN_ACCOUNT_LIMIT=10 per 15 minutes
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=4

# Internal map tile server (leave empty for a map without a basemap). When set, also allow its
# host in the browser policy, e.g. CSP_IMG_SRC_EXTRA=https://tiles.sonatrach.dz
# MAP_TILE_URL=https://tiles.sonatrach.dz/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=
# MAP_TILE_SUBDOMAINS=
# CSP_IMG_SRC_EXTRA=

# Email (approval notifications, password reset requests); off unless DISABLE_OUTBOUND_EMAIL=false
# DISABLE_OUTBOUND_EMAIL=true
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# EMAIL_FROM=
