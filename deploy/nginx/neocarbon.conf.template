# Neocarbon: the SPA and the API on one address.
# Template variables (filled by the nginx image at start, or by envsubst on a native install):
#   SERVER_NAME        public host name, e.g. neocarbon.sonatrach.dz
#   APP_UPSTREAM       gunicorn address, e.g. app:8000 (containers) or 127.0.0.1:8000 (native)
#   SPA_ROOT           folder holding the built SPA (index.html, assets/)
#   TLS_CERT, TLS_KEY  certificate chain and private key (PEM)
#   CLIENT_MAX_BODY    upload limit, a little above the app's MAX_CONTENT_LENGTH (50 MB)
#   CSP_IMG_SRC_EXTRA  extra image sources for map tiles (MAP_TILE_URL host), or empty

upstream neocarbon_app {
    server ${APP_UPSTREAM};
    keepalive 16;
}

server {
    listen 80;
    server_name ${SERVER_NAME};
    # Plain HTTP only redirects (the session cookie is Secure).
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     ${TLS_CERT};
    ssl_certificate_key ${TLS_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:neocarbon_tls:10m;
    ssl_session_timeout 1d;

    server_tokens off;
    client_max_body_size ${CLIENT_MAX_BODY};

    # Security headers for every response (the API adds its own as well).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    # Same-origin requests keep the full Referer: the CSRF check over HTTPS needs it.
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${CSP_IMG_SRC_EXTRA}; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location /api/ {
        proxy_pass http://neocarbon_app;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # $http_host keeps a non-standard port (e.g. :8443): the CSRF check compares the Referer
        # with this host, port included.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;
        # Report generation and large exports
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # Uploads stream straight to the app.
        proxy_request_buffering off;
    }

    root ${SPA_ROOT};

    # Hashed build assets never change under the same name.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Client-side routes (/dashboard, /reports, ...) all load index.html, which is never cached.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${CSP_IMG_SRC_EXTRA}; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        try_files $uri $uri/ /index.html;
    }
}
