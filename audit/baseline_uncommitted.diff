@@ -187,3 +187,22 @@ def test_uncertainty_category_95ci(client, admin_user):
             assert abs(u_95 - 2.0 * u_1s) < 1e-10, (
                 f"Category '{cat['category']}': 95% CI ({u_95}) should be 2 × 1σ ({u_1s})"
             )
+
