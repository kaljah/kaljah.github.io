+ import React, { useState } from 'react';
+ import { AlertTriangle, ExternalLink, HelpCircle } from 'lucide-react';
+ import { FactorLineageModal } from './FactorLineageModal';
+ 
+ interface FactorItem {
+   id: string;
+   name: string;
+   value: number;
+   unit: string;
+   source: string;
+   is_silent_default: boolean;
+   warning_flag: string;
+   message?: string;
+ }
+ 
+ interface SilentDefaultBannerProps {
+   factors: FactorItem[];
+   onOverrideRequested?: (factorId: string) => void;
+ }
+ 
+ export const SilentDefaultBanner: React.FC<SilentDefaultBannerProps> = ({ factors, onOverrideRequested }) => {
+   const [showModal, setShowModal] = useState(false);
+   const silentDefaults = factors.filter(f => f.is_silent_default);
+ 
+   if (silentDefaults.length === 0) return null;
+ 
+   return (
+     <>
+       <div className="bg-amber-500/10 border border-amber-500/30 rounded-lg p-3.5 mb-4 flex items-start gap-3 text-amber-200">
+         <AlertTriangle className="w-5 h-5 text-amber-400 shrink-0 mt-0.5" />
+         <div className="flex-1 text-sm">
+           <span className="font-semibold text-amber-300">Methodology Notice: </span>
+           This calculation relies on {silentDefaults.length} unverified silent default assumption{silentDefaults.length > 1 ? 's' : ''} ({silentDefaults.map(f => `${f.name}: ${f.value} ${f.unit}`).join(', ')}).
+           <button
+             onClick={() => setShowModal(true)}
+             className="ml-2 inline-flex items-center gap-1 text-amber-300 underline hover:text-amber-100 font-medium"
+           >
+             Inspect Provenance & Override <ExternalLink className="w-3.5 h-3.5" />
+           </button>
+         </div>
+       </div>
+       {showModal && (
+         <FactorLineageModal factors={factors} onClose={() => setShowModal(false)} onOverride={onOverrideRequested} />
+       )}
+     </>
+   );
+ };
