+     """
+     __tablename__ = 'factor_provenance_registry'
+ 
+     id = db.Column(db.String(64), primary_key=True)  # e.g. 'PHY-012', 'FLR-001', 'SCP2-004'
+     factor_key = db.Column(db.String(128), nullable=False, index=True)
+     category = db.Column(db.String(64), nullable=False)  # 'physical_constant', 'emission_factor', 'gwp', etc.
+     parameter_name = db.Column(db.String(255), nullable=False)
+     value = db.Column(db.Numeric(18, 8), nullable=False)
+     unit = db.Column(db.String(64), nullable=False)
+     basis = db.Column(db.String(128), nullable=False)  # e.g. '60 F, 14.696 psia, 23.685 m3/kmol'
+     source_document = db.Column(db.String(255), nullable=False)  # e.g. 'API Compendium 2021'
+     edition_year = db.Column(db.String(32), nullable=False)      # e.g. '4th Edition (November 2021)'
+     table_or_equation_ref = db.Column(db.String(128), nullable=False)  # e.g. 'Section 3.4 / Table 3-7'
+     page_number = db.Column(db.String(32))                       # e.g. 'p. 3-8'
+     verbatim_citation = db.Column(db.Text, nullable=False)
+     is_user_overridable = db.Column(db.Boolean, default=True, nullable=False)
+     is_silent_default = db.Column(db.Boolean, default=False, nullable=False)
+     warning_flag = db.Column(db.String(32), default='NONE', nullable=False)
