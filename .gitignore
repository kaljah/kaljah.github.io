*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
users_v2.db
new/server/ghg_app.db*

# Python compiled bytecode & environments
__pycache__/
**/__pycache__/
*.py[cod]
*.class
*.pyd
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Node.js & Frontend build
node_modules/
**/node_modules/
dist/
new/client/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & Editor Files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude/
.cursor/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Logs & Temporary files
*.log
logs/
scratch/
**/scratch/
temp/
tmp/

# Large generated test benchmark files
1m_exhaustive_test.*
100k_test.*
