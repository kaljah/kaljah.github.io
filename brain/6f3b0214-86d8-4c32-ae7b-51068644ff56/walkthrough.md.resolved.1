    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const userStr = localStorage.getItem('ghg_user');
            const user = userStr ? JSON.parse(userStr) : null;

            if (!user || !user.id) {
                window.location.href = 'index.html';
                return;
            }

            // --- TAB SWITCH VIEW LOGIC ---
            const navItems = document.querySelectorAll('.nav-item');
            const tabContents = document.querySelectorAll('.settings-card');

            navItems.forEach(item => {
                item.addEventListener('click', () => {
                    const targetTab = item.getAttribute('data-tab');
                    
                    // Update active nav
                    navItems.forEach(i => i.classList.remove('active'));
                    item.classList.add('active');

                    // Show target tab content
                    tabContents.forEach(content => {
                        if (content.id === `tab-${targetTab}`) {
                            content.classList.remove('hidden-tab');
                        } else {
                            content.classList.add('hidden-tab');
                        }
                    });
                });
            });

            // Populate form fields
            const heroAvatar = document.getElementById('hero-avatar');
            const heroName = document.getElementById('hero-name');
            const heroRole = document.getElementById('hero-role');
            const topBarName = document.getElementById('current-user-name');

            const fullNameInput = document.getElementById('full-name');
            const usernameInput = document.getElementById('username');
            const emailInput = document.getElementById('email');
            const jobTitleInput = document.getElementById('job-title');
            const departmentInput = document.getElementById('department');
            const companyInput = document.getElementById('company');
            const phoneInput = document.getElementById('phone');
            const locationInput = document.getElementById('location');
            const bioInput = document.getElementById('bio');

            function updateDisplay(u) {
                if (u.fullName) {
                    if (heroAvatar) heroAvatar.textContent = u.fullName.charAt(0).toUpperCase();
                    if (heroName) heroName.textContent = u.fullName;
                    if (topBarName) topBarName.textContent = u.fullName;
                }
                if (u.jobTitle && heroRole) heroRole.textContent = u.jobTitle;
                else if (heroRole) heroRole.textContent = 'Energy Operations Manager';
            }

            updateDisplay(user);

            if (fullNameInput) fullNameInput.value = user.fullName || '';
            if (usernameInput) usernameInput.value = user.fullName ? user.fullName.toLowerCase().replace(/\s/g, '_') : '';
            if (emailInput) emailInput.value = user.email || '';
            if (jobTitleInput) jobTitleInput.value = user.jobTitle || '';
            if (departmentInput) departmentInput.value = user.department || '';
            if (companyInput) companyInput.value = user.orgName || user.company || '';
            if (phoneInput) phoneInput.value = user.phone || '';
            if (locationInput) locationInput.value = user.location || '';
            if (bioInput) bioInput.value = user.bio || '';

            // Profile form submission
            document.getElementById('profile-form').addEventListener('submit', async (e) => {
                e.preventDefault();
                const updatedData = { fullName: fullNameInput.value, email: emailInput.value };
                try {
                    const res = await fetch(`/api/users/${user.id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json', 'X-User-Id': user.id },
                        body: JSON.stringify(updatedData)
                    });
                    if (res.ok) {
                        user.fullName = updatedData.fullName;
                        user.email = updatedData.email;
                        localStorage.setItem('ghg_user', JSON.stringify(user));
                        updateDisplay(user);
                        if (window.toastSuccess) toastSuccess('Personal details updated');
                    }
                } catch (error) { console.error(error); }
            });

            // Professional form submission
            document.getElementById('professional-form').addEventListener('submit', async (e) => {
                e.preventDefault();
                const professionalData = {
                    jobTitle: jobTitleInput.value,
                    department: departmentInput.value,
                    company: companyInput.value,
                    phone: phoneInput.value,
                    location: locationInput.value,
                    bio: bioInput.value
                };
                try {
                    const res = await fetch(`/api/users/${user.id}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json', 'X-User-Id': user.id },
                        body: JSON.stringify(professionalData)
                    });
                    if (res.ok) {
                        Object.assign(user, professionalData);
                        localStorage.setItem('ghg_user', JSON.stringify(user));
                        updateDisplay(user);
                        if (window.toastSuccess) toastSuccess('Professional information updated');
                    }
                } catch (error) { console.error(error); }
            });

            // Password form submission
            document.getElementById('password-form').addEventListener('submit', async (e) => {
                e.preventDefault();
                const currentPassword = document.getElementById('current-password').value;
                const newPassword = document.getElementById('new-password').value;
                const confirmPassword = document.getElementById('confirm-password').value;

                if (newPassword !== confirmPassword) { toastError('Passwords do not match'); return; }

                try {
                    const res = await fetch(`/api/users/${user.id}/password`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json', 'X-User-Id': user.id },
                        body: JSON.stringify({ currentPassword, newPassword })
                    });
                    if (res.ok) {
                        toastSuccess('Password updated successfully');
                        document.getElementById('password-form').reset();
                    } else {
                        const err = await res.json();
                        toastError(err.message || 'Failed to update password');
                    }
                } catch (error) { console.error(error); }
            });
        });

        function confirmDeleteAccount() {
            if (confirm('Are you absolutely sure you want to delete your account? This action cannot be undone.')) {
                // Account deletion logic
                toastWarning('Account deletion feature pending administrative approval');
            }
        }
    </script>
</body>

</html>
</html>
