            border-color: rgba(16, 185, 129, 0.2);
        }

        .nav-item svg {
            width: 20px;
            height: 20px;
        }

        /* Content Area */
        .profile-content {
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        .profile-hero {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            padding: 32px;
            backdrop-filter: blur(20px);
            display: flex;
            align-items: center;
            gap: 24px;
            position: relative;
            overflow: hidden;
        }

        .profile-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -10%;
            width: 40%;
            height: 200%;
            background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
            z-index: 0;
            pointer-events: none;
        }

        .avatar-wrapper {
            position: relative;
            z-index: 1;
        }

        .avatar-large {
            width: 100px;
            height: 100px;
            border-radius: 30px;
            background: linear-gradient(135deg, var(--accent-color), #059669);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-weight: 700;
            color: white;
            box-shadow: 0 10px 25px rgba(16, 185, 129, 0.3);
        }

        .hero-info {
            z-index: 1;
        }

        .hero-name {
            font-size: 1.75rem;
            font-weight: 700;
            margin-bottom: 4px;
            color: var(--text-primary);
        }

        .hero-sub {
            color: var(--text-secondary);
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Tab Content Cards */
        .settings-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 24px;
            padding: 32px;
            backdrop-filter: blur(20px);
            animation: fadeInScale 0.3s ease-out;
        }

        @keyframes fadeInScale {
            from { opacity: 0; transform: scale(0.98); }
            to { opacity: 1; transform: scale(1); }
