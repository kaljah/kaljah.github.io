            gap: 24px;
            max-width: 1200px;
            margin: 0 auto;
            padding: 24px;
        }

        /* Sidebar Nav */
        .profile-nav {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 20px;
            padding: 24px 16px;
            backdrop-filter: blur(20px);
            display: flex;
            flex-direction: column;
            gap: 8px;
            height: fit-content;
            position: sticky;
            top: 24px;
