    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const userStr = localStorage.getItem('ghg_user');
            const user = userStr ? JSON.parse(userStr) : null;

            if (!user || !user.id) {
                window.location.href = 'index.html';
                return;
            }

            // Populate form fields
            const avatarEl = document.getElementById('profile-avatar');
            const nameEl = document.getElementById('profile-name');
            const fullNameInput = document.getElementById('full-name');
            const usernameInput = document.getElementById('username');
            const emailInput = document.getElementById('email');
            const jobTitleInput = document.getElementById('job-title');
            const departmentInput = document.getElementById('department');
            const companyInput = document.getElementById('company');
            const phoneInput = document.getElementById('phone');
            const locationInput = document.getElementById('location');
            const roleEl = document.getElementById('profile-role');

            if (user.fullName) {
                if (avatarEl) avatarEl.textContent = user.fullName.charAt(0).toUpperCase();
                if (nameEl) nameEl.textContent = user.fullName;
                if (fullNameInput) fullNameInput.value = user.fullName;
            }

            if (user.username) {
                if (usernameInput) usernameInput.value = user.username;
            }

            if (user.email) {
                if (emailInput) emailInput.value = user.email;
            }

            // Load professional info
            if (user.jobTitle) {
                if (jobTitleInput) jobTitleInput.value = user.jobTitle;
                if (roleEl) roleEl.textContent = user.jobTitle;
            }
            if (user.department && departmentInput) departmentInput.value = user.department;
            if (user.company && companyInput) companyInput.value = user.company;
            if (user.phone && phoneInput) phoneInput.value = user.phone;
            if (user.location && locationInput) locationInput.value = user.location;
            const bioInput = document.getElementById('bio');
            if (user.bio && bioInput) bioInput.value = user.bio;

            // Profile form submission
            document.getElementById('profile-form').addEventListener('submit', async (e) => {
                e.preventDefault();

                const updatedData = {
                    fullName: fullNameInput.value,
                    email: emailInput.value
                };

                try {
                    const res = await fetch(`/api/users/${user.id}`, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-User-Id': user.id
                        },
                        body: JSON.stringify(updatedData)
                    });

                    if (res.ok) {
                        // Update localStorage
                        user.fullName = updatedData.fullName;
                        user.email = updatedData.email;
                        localStorage.setItem('ghg_user', JSON.stringify(user));

                        // Update display
                        if (avatarEl) avatarEl.textContent = user.fullName.charAt(0).toUpperCase();
                        if (nameEl) nameEl.textContent = user.fullName;

                        if (typeof toastSuccess === 'function') {
                            toastSuccess('Profile updated successfully');
                        } else {
                            console.log('Profile updated successfully');
                        }
                    } else {
                        const error = await res.json();
                        if (typeof toastError === 'function') {
                            toastError(error.message || 'Failed to update profile');
                        }
                    }
                } catch (error) {
                    console.error('Error updating profile:', error);
                    if (typeof toastError === 'function') toastError('Error updating profile');
                }
            });

            // Professional form submission
            document.getElementById('professional-form').addEventListener('submit', async (e) => {
                e.preventDefault();

                const professionalData = {
                    jobTitle: jobTitleInput.value,
                    department: departmentInput.value,
                    company: companyInput.value,
                    phone: phoneInput.value,
                    location: locationInput.value,
                    bio: bioInput.value
                };

                try {
                    const res = await fetch(`/api/users/${user.id}`, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-User-Id': user.id
                        },
                        body: JSON.stringify(professionalData)
                    });

                    if (res.ok) {
                        // Update localStorage
                        Object.assign(user, professionalData);
                        localStorage.setItem('ghg_user', JSON.stringify(user));

                        // Update display
                        if (roleEl && professionalData.jobTitle) {
                            roleEl.textContent = professionalData.jobTitle;
                        }

                        if (typeof toastSuccess === 'function') {
                            toastSuccess('Professional info updated successfully');
                        } else {
                            console.log('Professional info updated successfully');
                        }
                    } else {
                        if (typeof toastError === 'function') toastError('Failed to update professional info');
                    }
                } catch (error) {
                    console.error('Error updating professional info:', error);
                    if (typeof toastError === 'function') toastError('Error updating professional info');
                }
            });

            // Password form submission
            document.getElementById('password-form').addEventListener('submit', async (e) => {
                e.preventDefault();

                const currentPassword = document.getElementById('current-password').value;
                const newPassword = document.getElementById('new-password').value;
                const confirmPassword = document.getElementById('confirm-password').value;

                if (newPassword !== confirmPassword) {
                    console.error('Passwords do not match');
                    return;
                }

                if (newPassword.length < 6) {
                    console.error('Password must be at least 6 characters');
                    return;
                }

                try {
                    const res = await fetch(`/api/users/${user.id}/password`, {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-User-Id': user.id
                        },
                        body: JSON.stringify({ currentPassword, newPassword })
                    });

                    if (res.ok) {
                        if (typeof toastSuccess === 'function') {
                            toastSuccess('Password updated successfully');
                        } else {
                            console.log('Password updated successfully');
                        }
                        // Clear password fields
                        document.getElementById('current-password').value = '';
                        document.getElementById('new-password').value = '';
                        document.getElementById('confirm-password').value = '';
                    } else {
                        const err = await res.json();
                        if (typeof toastError === 'function') toastError(err.message || 'Failed to update password');
                    }
                } catch (error) {
                    console.error('Error updating password:', error);
                    if (typeof toastError === 'function') toastError('Error updating password');
                }
            });
        });

        function confirmDeleteAccount() {
            if (confirm('Are you absolutely sure you want to delete your account? This action cannot be undone.')) {
                // Implement account deletion logic here
                console.log('Account deletion requested');
            }
        }
    </script>
