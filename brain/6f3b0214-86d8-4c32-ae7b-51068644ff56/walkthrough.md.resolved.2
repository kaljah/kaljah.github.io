// Master database for user authentication
let usersDb;

// Cache for user databases
const userDbCache = {};

// Initialize Master Users Database
function initUsersDatabase() {
    usersDb = new sqlite3.Database(USERS_DB_PATH, (err) => {
        if (err) {
            console.error('Error opening users database:', err.message);
        } else {
            console.log('Connected to the users database.');
            createUsersTable();
        }
    });
}

function createUsersTable() {
    usersDb.run(`CREATE TABLE IF NOT EXISTS users (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        fullName TEXT NOT NULL,
        orgName TEXT NOT NULL,
        password TEXT NOT NULL,
        sector TEXT NOT NULL,
        email TEXT,
        jobTitle TEXT,
        department TEXT,
        phone TEXT,
        location TEXT,
        bio TEXT,
        profilePic TEXT,
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP
    )`, (err) => {
        if (err) {
            console.error('Error creating users table:', err.message);
        } else {
            console.log('Users table ready.');
            // Migration: Add new columns if they don't exist
            const columns = ['email', 'jobTitle', 'department', 'phone', 'location', 'bio', 'profilePic'];
            columns.forEach(col => {
                usersDb.run(`ALTER TABLE users ADD COLUMN ${col} TEXT`, (err) => {
                    // Ignore error if column already exists
                });
            });
        }
    });
}

// Get or create user-specific database
function getUserDatabase(userId, username) {
    // Check cache first
    if (userDbCache[userId]) {
        return userDbCache[userId];
    }

    // Sanitize username for filename (remove spaces and special characters)
    const sanitizedUsername = username.replace(/[^a-zA-Z0-9_-]/g, '_');
    const dbPath = path.join(USER_DBS_DIR, `${sanitizedUsername}.db`);

    const db = new sqlite3.Database(dbPath, (err) => {
        if (err) {
            console.error(`Error opening database for user ${username}:`, err.message);
        } else {
            console.log(`Connected to database for user ${username} (${sanitizedUsername}.db)`);
            initUserSchema(db);
        }
    });

    userDbCache[userId] = db;
    return db;
}

// Initialize schema for user-specific database
function initUserSchema(db) {
    db.serialize(() => {
        // Emissions Table
        db.run(`CREATE TABLE IF NOT EXISTS emissions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            record_id TEXT,
            year INTEGER,
            month INTEGER,
            company_name TEXT,
            group_name TEXT,
            equipment_id TEXT,
            process_type TEXT,
            fuel_type TEXT,
            quantity REAL,
            unit TEXT,
            factor_source TEXT,
            ef_used_co2 REAL,
            ef_used_ch4 REAL,
            ef_used_n2o REAL,
            co2_emissions REAL,
            ch4_emissions REAL,
            n2o_emissions REAL,
            co2e_total REAL,
            timestamp DATETIME DEFAULT CURRENT_TIMESTAMP
        )`);

        db.run(`CREATE TABLE IF NOT EXISTS custom_factors (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT,
            co2_factor REAL,
            ch4_factor REAL,
            n2o_factor REAL,
            unit TEXT,
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP
        )`);

        // Goals Table
        db.run(`CREATE TABLE IF NOT EXISTS goals (
            year INTEGER PRIMARY KEY,
            target_amount REAL,
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP
        )`);

        // Facilities Table
        db.run(`CREATE TABLE IF NOT EXISTS facilities (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT,
            location TEXT,
            description TEXT,
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP
        )`);

        // Migration: Add facility_id to emissions if not exists
        db.run(`ALTER TABLE emissions ADD COLUMN facility_id INTEGER`, (err) => {
            // Ignore error if column already exists
        });

        // Audit Log Table
        db.run(`CREATE TABLE IF NOT EXISTS audit_log (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            action TEXT,
            record_id TEXT,
            user_name TEXT,
            timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
            details TEXT
        )`);
    });
}

// Authentication Middleware
function authMiddleware(req, res, next) {
    const userId = req.headers['x-user-id'];

    if (!userId) {
        return res.status(401).json({ message: 'Authentication required' });
    }

    // Verify user exists
    usersDb.get('SELECT id, fullName, orgName FROM users WHERE id = ?', [userId], (err, user) => {
        if (err || !user) {
            return res.status(401).json({ message: 'Invalid user' });
        }

        req.user = user;
        req.userDb = getUserDatabase(userId, user.fullName);
        next();
    });
}

