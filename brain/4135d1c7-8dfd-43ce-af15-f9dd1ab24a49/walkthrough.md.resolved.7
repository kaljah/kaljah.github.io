document.addEventListener('DOMContentLoaded', async function () {
    const userStr = localStorage.getItem('ghg_user');
    const user = userStr ? JSON.parse(userStr) : null;

    if (!user || !user.id) {
        window.location.href = 'index.html';
        return;
    }

    // Dashboard specific logic starts here
    const topNameEl = document.getElementById('user-name-top');
    if (topNameEl && user.fullName) {
        topNameEl.textContent = user.fullName;
    }

    const dropCompanyEl = document.querySelector('.user-company-drop');
    if (dropCompanyEl && user.orgName) {
        dropCompanyEl.textContent = user.orgName;
    }

    // Custom Facility Dropdown Logic
    const facilityDropdown = document.getElementById('facility-dropdown');
    const facilityDisplay = document.getElementById('facility-display');
    const facilityOptionsContainer = document.getElementById('facility-options');
    const selectedFacilityText = document.getElementById('selected-facility-name');
    let facilities = [];
    let currentFacilityId = 'all';

    // Toggle Dropdown
    if (facilityDisplay) {
        facilityDisplay.addEventListener('click', (e) => {
            e.stopPropagation();
            facilityDropdown.classList.toggle('active');
        });
    }

    // Load Facilities
    try {
        const facilitiesRes = await fetch('/api/facilities', {
            headers: { 'X-User-Id': user.id }
        });
        if (facilitiesRes.ok) {
            facilities = await facilitiesRes.json();

            // Rebuild options list
            let optionsHtml = '<div class="dropdown-option selected" data-value="all">All Facilities</div>';
            optionsHtml += facilities.map(f => `<div class="dropdown-option" data-value="${f.id}">${f.name}</div>`).join('');

            if (facilityOptionsContainer) {
                facilityOptionsContainer.innerHTML = optionsHtml;

                // Add click listeners to new options
                const options = facilityOptionsContainer.querySelectorAll('.dropdown-option');
                options.forEach(option => {
                    option.addEventListener('click', async () => {
                        const val = option.getAttribute('data-value');
                        const name = option.textContent;
                        currentFacilityId = val;

                        // Update UI
                        options.forEach(opt => opt.classList.remove('selected'));
                        option.classList.add('selected');
                        selectedFacilityText.textContent = name;
                        facilityDropdown.classList.remove('active');

                        // Update Hero-Card Badge
                        const badge = document.getElementById('selected-facility-badge');
                        if (badge) badge.textContent = name;

                        // Reload Data
                        await loadDashboardData(user, val);
                    });
                });
            }
        }
    } catch (e) {
        console.warn('Failed to load facilities', e);
    }

    // Close dropdown on click outside
    document.addEventListener('click', () => {
        if (facilityDropdown) facilityDropdown.classList.remove('active');
    });

    // Initial load
    await loadDashboardData(user, 'all');

    // Goal modal handlers
    const goalModal = document.getElementById('goal-modal');
    const setGoalBtn = document.getElementById('set-goal-btn');
    const closeModal = document.getElementById('close-modal');
    const cancelGoal = document.getElementById('cancel-goal');
    const saveGoal = document.getElementById('save-goal');
    const goalYearInput = document.getElementById('goal-year');
    const goalTargetInput = document.getElementById('goal-target');

    // Set current year as default
    goalYearInput.value = new Date().getFullYear();

    setGoalBtn.addEventListener('click', () => {
        goalModal.classList.add('active');
    });

    closeModal.addEventListener('click', () => {
        goalModal.classList.remove('active');
    });

    cancelGoal.addEventListener('click', () => {
        goalModal.classList.remove('active');
    });

    saveGoal.addEventListener('click', async () => {
        const year = parseInt(goalYearInput.value);
        const target = parseFloat(goalTargetInput.value);

        if (!year || !target || target <= 0) {
            toastError('Please enter a valid year and target value');
            return;
        }

        // --- OPTIMISTIC/REAL-TIME UPDATE ---
        // 1. Close the modal immediately
        goalModal.classList.remove('active');

        // 2. Perform optimistic UI update if we have cached data
        if (window.lastProcessedData) {
            updateHeroMetrics(window.lastProcessedData, { year, target_amount: target }, window.lastBaseYear);
        }

        try {
            const res = await fetch('/api/goals', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-User-Id': user.id
                },
                body: JSON.stringify({ year, target_amount: target })
            });

            if (res.ok) {
                toastSuccess('Goal saved successfully!');
                // Final sync with server data
                await loadDashboardData(user, currentFacilityId);
            } else {
                toastError('Failed to save goal');
            }
        } catch (e) {
            console.error(e);
            toastError('Error saving goal');
        }
    });

    // Base year modal handlers
    const baseYearModal = document.getElementById('base-year-modal');
    const setBaseYearBtn = document.getElementById('set-base-year-btn');
