    if (cancelBaseYear) {
        cancelBaseYear.addEventListener('click', () => {
            if (baseYearModal) baseYearModal.classList.remove('active');
        });
    }

    if (saveBaseYear) {
        saveBaseYear.addEventListener('click', async () => {
            const year = parseInt(baseYearInput.value, 10);
            const reasonField = document.getElementById('base-year-reason');
            const reason = reasonField?.value.trim() || '';

            if (!Number.isInteger(year) || year < 1900 || year > 2100) {
                toastError('Please enter a valid base year');
                return;
            }

            if (!reason) {
                toastError('A reason for recalculation is required for ISO 14064-1 compliance.');
                return;
            }

            if (baseYearModal) baseYearModal.classList.remove('active');

            try {
                const res = await fetch('/api/base-year-recalculation', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-User-Id': user.id
                    },
                    body: JSON.stringify({ year, reason })
                });

                if (res.ok) {
                    localStorage.setItem('ghg_base_year', JSON.stringify({ year, locked: true }));
                    toastSuccess('Base year recalculated and logged');
                    await loadDashboardData(user, currentFacilityId);
                } else if (res.status === 409) {
                    toastError('Base year is locked and cannot be changed');
                } else {
                    toastError('Failed to save base year');
                }
            } catch (e) {
                console.error(e);
                toastError('Error saving base year');
            }
        });
    }
});

// Cache for real-time updates
window.lastProcessedData = null;
window.lastBaseYear = null;

async function loadDashboardData(user, facilityId = 'all') {
    try {
        // Fetch raw emissions data for charts with authentication
        const response = await fetch('/api/emissions', {
            headers: { 'X-User-Id': user.id }
        });
        const emissionsData = await response.json();
        console.log(`Loaded ${emissionsData.length} emission records for dashboard.`);

        // Filter by facility if needed
        const filteredData = facilityId === 'all'
            ? emissionsData
            : emissionsData.filter(r => r.facility_id == facilityId);

        // --- DATA PROCESSING ---
        const processedData = processEmissionsData(filteredData);
        window.lastProcessedData = processedData;

        // Fetch goal for current year
        const currentYear = new Date().getFullYear();
        let goal = null;
        try {
            const goalRes = await fetch(`/api/goals/${currentYear}`, {
                headers: { 'X-User-Id': user.id }
            });
            if (goalRes.ok) {
                goal = await goalRes.json();
            }
        } catch (e) {
            console.warn('Could not fetch goal', e);
        }

        let baseYear = null;
        try {
            const baseRes = await fetch('/api/base-year', {
                headers: { 'X-User-Id': user.id }
            });
            if (baseRes.ok) {
                baseYear = await baseRes.json();
                window.lastBaseYear = baseYear;
                localStorage.setItem('ghg_base_year', JSON.stringify(baseYear));
            }
        } catch (e) {
            const localBaseYear = localStorage.getItem('ghg_base_year');
            baseYear = localBaseYear ? JSON.parse(localBaseYear) : null;
            window.lastBaseYear = baseYear;
        }

        applyBaseYearUiState(baseYear);

        // --- UPDATE UI ---
        updateHeroMetrics(processedData, goal, baseYear);
        updateBreakdownTable(processedData);
        renderTrendChart(processedData.trend);
        renderSourceChart(processedData.bySource);

        // Update last updated time
        // Update last updated time with Timezone support
        const lastUpdatedEl = document.getElementById('last-updated-time');
        if (lastUpdatedEl) {
            const tz = localStorage.getItem('ghg_timezone') || 'UTC';
            try {
                lastUpdatedEl.textContent = new Date().toLocaleTimeString('en-US', { 
                    hour: '2-digit', 
                    minute: '2-digit',
                    timeZone: tz,
                    timeZoneName: 'short'
                });
            } catch (e) {
                console.warn('Invalid timezone, falling back to local');
                lastUpdatedEl.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            }
        }

    } catch (error) {
        console.warn('Backend unavailable (Offline Mode). Using local storage for dashboard.');

        // Fallback: Load from Local Storage
        const localData = JSON.parse(localStorage.getItem('ghg_activity_log')) || [];

        // Filter by facility if needed
        const filteredData = facilityId === 'all'
            ? localData
            : localData.filter(r => r.facilityId == facilityId);

        const mappedData = filteredData.map(r => ({
            ...r,
            process_type: r.process,
            co2e_total: r.emissions ? r.emissions.totalCo2e : 0,
            timestamp: new Date().toISOString() // Placeholder
        }));

        const processedData = processEmissionsData(mappedData);
        window.lastProcessedData = processedData;
        const localBaseYear = localStorage.getItem('ghg_base_year');
        const baseYear = localBaseYear ? JSON.parse(localBaseYear) : null;
        window.lastBaseYear = baseYear;
        applyBaseYearUiState(baseYear);
        updateHeroMetrics(processedData, null, baseYear);
        updateBreakdownTable(processedData);
        renderTrendChart(processedData.trend);
        renderSourceChart(processedData.bySource);
    }
}

function processEmissionsData(data) {
    if (!data || data.length === 0) {
        return {
            total: 0,
            scope1: 0,
            scope2: 0,
            trend: {},
            bySource: { combustion: 0, flaring: 0, venting: 0, other: 0 }
        };
    }

    const currentYear = new Date().getFullYear();
    let totalEmissions = 0;
    let scope1Total = 0;
    let scope2Total = 0;
    let yearlyData = {};
    let sourceBreakdown = { combustion: 0, flaring: 0, venting: 0, other: 0 };

    data.forEach(record => {
        const val = record.co2e_total || 0;
        const ch4 = (record.ch4_emissions || (record.emissions ? record.emissions.ch4 : 0)) || 0;
        const process = (record.process_type || '').toLowerCase();
        const year = record.year || new Date(record.timestamp).getFullYear();

        totalEmissions += val;

        let isScope2 = (process === 'electricity' || process === 'purchased_energy');

        if (isScope2) {
            scope2Total += val;
        } else {
            scope1Total += val;
        }

        // Source Breakdown
        if (process.includes('combustion')) sourceBreakdown.combustion += val;
        else if (process.includes('flaring')) sourceBreakdown.flaring += val;
        else if (process.includes('venting')) sourceBreakdown.venting += val;
        else sourceBreakdown.other += val;

        // Trend Data
        if (!yearlyData[year]) yearlyData[year] = { s1Total: 0, s2Total: 0 };

        if (isScope2) {
            yearlyData[year].s2Total += val;
        } else {
            yearlyData[year].s1Total += val;
        }
    });

    return {
        total: totalEmissions,
        scope1: scope1Total,
        scope2: scope2Total,
        trend: yearlyData,
        bySource: sourceBreakdown
    };
}

function updateHeroMetrics(data, goal, baseYear) {
    // Total Emissions
    const totalEl = document.getElementById('total-emissions');
    if (totalEl) totalEl.textContent = data.total.toLocaleString(undefined, { minimumFractionDigits: 3, maximumFractionDigits: 3 });

    // --- Trend Calculation Helpers ---
    const getTrendColor = (percent) => percent < 0 ? 'var(--success)' : 'var(--danger)';
    const getTrendIcon = (percent) => percent < 0 ? '↓' : '↑';

    const updateTrendBadge = (elementId, current, reference) => {
        const el = document.getElementById(elementId);
        if (!el) return;

        if (reference > 0) {
            const percent = ((current - reference) / reference) * 100;
            el.textContent = `${getTrendIcon(percent)} ${Math.abs(percent).toFixed(1)}%`;
            el.style.color = getTrendColor(percent);
        } else {
            el.textContent = '—';
            el.style.color = 'var(--text-secondary)';
        }
    };

    // 1. Total Trend (Base Year >> Goal)
    let refTotal = 0;
    if (baseYear && baseYear.year && data.trend[baseYear.year]) {
        const bd = data.trend[baseYear.year];
        refTotal = (bd.s1Total || 0) + (bd.s2Total || 0);
    } else if (goal && goal.target_amount) {
        refTotal = goal.target_amount;
    }
    updateTrendBadge('trend-badge-total', data.total, refTotal);

    // 2. Scope Trends (Base Year >> Goal fallback)
    let refS1 = 0, refS2 = 0;
    if (baseYear && baseYear.year && data.trend[baseYear.year]) {
        refS1 = data.trend[baseYear.year].s1Total || 0;
        refS2 = data.trend[baseYear.year].s2Total || 0;
    } else if (goal && goal.target_amount) {
        // Fallback: Use goal percentage distribution if base year is missing
        refS1 = goal.target_amount * 0.6;
        refS2 = goal.target_amount * 0.4;
    }

    updateTrendBadge('trend-badge-scope1', data.scope1, refS1);
    updateTrendBadge('trend-badge-scope2', data.scope2, refS2);

    // Update goal target display
    const goalDisplay = document.getElementById('goal-target-display');
    if (goalDisplay && goal && goal.target_amount) {
        goalDisplay.textContent = `${goal.year || new Date().getFullYear()} Target: ${goal.target_amount.toLocaleString()}`;
    }

    // Scope 1 & 2 Totals
    const s1El = document.getElementById('scope1-total');
    const s2El = document.getElementById('scope2-total');
    if (s1El) s1El.textContent = data.scope1.toLocaleString(undefined, { minimumFractionDigits: 3, maximumFractionDigits: 3 });
    if (s2El) s2El.textContent = data.scope2.toLocaleString(undefined, { minimumFractionDigits: 3, maximumFractionDigits: 3 });
}

function applyBaseYearUiState(baseYear) {
    const display = document.getElementById('base-year-display');
    if (display) {
        display.textContent = baseYear && baseYear.year ? `Base Year: ${baseYear.year}` : 'Base Year: Not set';
    }

    const setBtn = document.getElementById('set-base-year-btn');
    const setBtnLabel = document.getElementById('set-base-year-label');
    if (setBtnLabel) {
        setBtnLabel.textContent = baseYear && baseYear.year ? `Base Year: ${baseYear.year}` : 'Set Base Year';
    }

    const input = document.getElementById('base-year-input');
    const saveBtn = document.getElementById('save-base-year');
    if (input && saveBtn) {
        // Change from locked to always active to allow formal recalculation (ISO §5.2)
        input.disabled = false;
        saveBtn.disabled = false;

        if (baseYear && baseYear.year) {
            input.value = baseYear.year;
            // Clear reason field for new entry
            const reasonField = document.getElementById('base-year-reason');
            if (reasonField) reasonField.value = '';
        } else {
            input.value = new Date().getFullYear();
        }
    }
}

function updateBreakdownTable(data) {
    const s1Table = document.getElementById('table-scope1');
    const s2Table = document.getElementById('table-scope2');
    const totalTable = document.getElementById('table-total');
    const yearHeader = document.getElementById('table-year-header');

    const years = Object.keys(data.trend || {}).sort();
    const latestYear = years[years.length - 1];

    if (yearHeader) {
        yearHeader.textContent = latestYear ? `${latestYear} Results (tCO₂e)` : 'No Data';
    }

    if (latestYear) {
        const yearData = data.trend[latestYear];
        const s1Val = yearData.s1Total || 0;
        const s2Val = yearData.s2Total || 0;
        const totalVal = s1Val + s2Val;

        if (s1Table) s1Table.textContent = s1Val.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        if (s2Table) s2Table.textContent = s2Val.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        if (totalTable) totalTable.textContent = totalVal.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    } else {
        if (s1Table) s1Table.textContent = '0.00';
        if (s2Table) s2Table.textContent = '0.00';
        if (totalTable) totalTable.textContent = '0.00';
    }
}

function renderTrendChart(trendData) {
    const ctx = document.getElementById('trendChart');
    if (!ctx) return;

    // Destroy existing chart if it exists
    const existingChart = Chart.getChart(ctx);
    if (existingChart) existingChart.destroy();

    // Sort years
    const years = Object.keys(trendData).sort();
    const s1Vals = years.map(y => trendData[y].s1Total);
    const s2Vals = years.map(y => trendData[y].s2Total);

    const canvas = ctx.getContext('2d');

    // Create Gradients
    const s1Gradient = canvas.createLinearGradient(0, 0, 0, 400);
    s1Gradient.addColorStop(0, 'rgba(16, 185, 129, 0.4)');
    s1Gradient.addColorStop(1, 'rgba(16, 185, 129, 0)');

    const s2Gradient = canvas.createLinearGradient(0, 0, 0, 400);
    s2Gradient.addColorStop(0, 'rgba(99, 102, 241, 0.4)');
    s2Gradient.addColorStop(1, 'rgba(99, 102, 241, 0)');

    // Dark Theme Colors
    const s1Color = '#10b981'; // Emerald
    const s2Color = '#6366f1'; // Indigo
    const gridColor = 'rgba(255, 255, 255, 0.05)';
    const textColor = '#9ca3af';

    new Chart(canvas, {
        type: 'line',
        data: {
            labels: years.length ? years : ['No Data'],
            datasets: [
                {
                    label: 'Scope 1 Total (tCO2e)',
                    data: s1Vals,
                    borderColor: s1Color,
                    backgroundColor: s1Gradient,
                    borderWidth: 3,
                    pointBackgroundColor: '#111827',
                    pointBorderColor: s1Color,
                    pointHoverBackgroundColor: s1Color,
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    tension: 0.45,
                    fill: true
                },
                {
                    label: 'Scope 2 Total (tCO2e)',
                    data: s2Vals,
                    borderColor: s2Color,
                    backgroundColor: s2Gradient,
                    borderWidth: 3,
                    pointBackgroundColor: '#111827',
                    pointBorderColor: s2Color,
                    pointHoverBackgroundColor: s2Color,
                    pointRadius: 4,
                    pointHoverRadius: 6,
                    tension: 0.45,
                    fill: true
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
                mode: 'index',
                intersect: false,
            },
            plugins: {
                legend: {
                    display: true,
                    position: 'top',
                    labels: {
                        color: textColor,
                        usePointStyle: true,
                        pointStyle: 'circle',
                        padding: 25,
                        font: { size: 12, weight: '500' }
                    }
                },
                tooltip: {
                    backgroundColor: 'rgba(17, 24, 39, 0.95)',
                    titleColor: '#f3f4f6',
                    bodyColor: '#d1d5db',
                    borderColor: 'rgba(255,255,255,0.1)',
                    borderWidth: 1,
                    padding: 15,
                    boxPadding: 8,
                    usePointStyle: true,
                    callbacks: {
                        label: function (context) {
                            let label = context.dataset.label.split('(')[0].trim() || '';
                            if (label) label += ': ';
                            if (context.parsed.y !== null) {
                                label += context.parsed.y.toLocaleString(undefined, { minimumFractionDigits: 2 }) + ' tCO2e';
                            }
                            return label;
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: gridColor, drawBorder: false },
                    ticks: {
                        color: textColor,
                        padding: 10,
                        callback: value => value.toLocaleString() + ' t'
                    }
                },
                x: {
                    grid: { display: false },
                    ticks: {
                        color: textColor,
                        padding: 10
                    }
                }
            }
        }
    });
}

function renderSourceChart(sourceData) {
    const ctx = document.getElementById('sourceChart');
    if (!ctx) return;

    // Destroy existing chart if it exists
    const existingChart = Chart.getChart(ctx);
    if (existingChart) existingChart.destroy();

    const total = sourceData.combustion + sourceData.flaring + sourceData.venting + sourceData.other;

    // Custom Plugin for Center Text
    const centerTextPlugin = {
        id: 'centerText',
        afterDraw: (chart) => {
            const { ctx, chartArea: { top, bottom, left, right, width, height } } = chart;
            ctx.save();

            // Total Label
            ctx.font = '600 1.5rem Outfit';
            ctx.fillStyle = '#f3f4f6';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            const totalText = total.toLocaleString(undefined, { maximumFractionDigits: 1 });
            ctx.fillText(totalText, width / 2 + left, height / 2 + top - 5);

            // Unit Label
            ctx.font = '500 0.75rem Outfit';
            ctx.fillStyle = '#9ca3af';
            ctx.fillText('tCO2e Total', width / 2 + left, height / 2 + top + 20);

            ctx.restore();
        }
    };

    new Chart(ctx.getContext('2d'), {
        type: 'doughnut',
        data: {
            labels: ['Combustion', 'Flaring', 'Venting', 'Other'],
            datasets: [{
                data: [sourceData.combustion, sourceData.flaring, sourceData.venting, sourceData.other],
                backgroundColor: [
                    '#10b981', // Emerald
                    '#f59e0b', // Amber
                    '#6366f1', // Indigo
                    '#64748b'  // Slate
                ],
                borderWidth: 0,
                borderRadius: 10,
                spacing: 8,
                hoverOffset: 15
            }]
        },
        plugins: [centerTextPlugin],
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '80%',
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        color: '#9ca3af',
                        usePointStyle: true,
                        pointStyle: 'circle',
                        padding: 20,
                        font: { size: 11, family: 'Outfit', weight: '500' }
                    }
                },
                tooltip: {
                    backgroundColor: 'rgba(17, 24, 39, 0.95)',
                    titleColor: '#f3f4f6',
                    bodyColor: '#d1d5db',
                    borderColor: 'rgba(255,255,255,0.1)',
                    borderWidth: 1,
                    padding: 12,
                    boxPadding: 8,
                    usePointStyle: true,
                    callbacks: {
                        label: function (context) {
                            const value = context.raw;
                            const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                            return ` ${context.label}: ${value.toLocaleString()} t (${percentage}%)`;
                        }
                    }
                }
            }
        }
    });
}


