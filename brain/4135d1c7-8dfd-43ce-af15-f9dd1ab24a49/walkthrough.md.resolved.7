    <script>
        // Tab switching logic for settings.html
        document.addEventListener('DOMContentLoaded', function () {
            const navItems = document.querySelectorAll('.nav-item');
            const tabCards = document.querySelectorAll('.settings-card');

            function switchTab(target) {
                // Update Active Nav
                navItems.forEach(nav => {
                    if (nav.getAttribute('data-tab') === target) {
                        nav.classList.add('active');
                    } else {
                        nav.classList.remove('active');
                    }
                });

                // Show Target Tab
                tabCards.forEach(card => {
                    if (card.id === `tab-${target}`) {
                        card.classList.remove('hidden-tab');
                    } else {
                        card.classList.add('hidden-tab');
                    }
                });
            }

            navItems.forEach(item => {
                item.addEventListener('click', () => {
                    const target = item.getAttribute('data-tab');
                    switchTab(target);
                });
            });

            // Check for URL parameter
            const urlParams = new URLSearchParams(window.location.search);
            const initialTab = urlParams.get('tab');
            if (initialTab && document.getElementById(`tab-${initialTab}`)) {
                switchTab(initialTab);
            }

            // Sync Top Avatar
            const user = JSON.parse(localStorage.getItem('ghg_user') || '{}');
            const topAvatar = document.getElementById('user-avatar-top');
            if (topAvatar && user.fullName) {
                topAvatar.textContent = user.fullName.charAt(0).toUpperCase();
            }
        });
    </script>
