function getUserDatabase(userId, username) {
    // Check cache first
    if (userDbCache[userId]) {
        return userDbCache[userId];
    }

    // Sanitize username for filename (remove spaces and special characters)
    const sanitizedUsername = username.replace(/[^a-zA-Z0-9_-]/g, '_');
    const dbPath = path.join(USER_DBS_DIR, `${sanitizedUsername}.db`);

    const db = new sqlite3.Database(dbPath, (err) => {
        if (err) {
            console.error(`Error opening database for user ${username}:`, err.message);
        } else {
            console.log(`Connected to database for user ${username} (${sanitizedUsername}.db)`);
            initUserSchema(db);
