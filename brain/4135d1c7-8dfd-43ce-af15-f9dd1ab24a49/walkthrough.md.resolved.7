        res.json({ year: row.year, locked: !!row.locked });
    });
});

app.post('/api/base-year', authMiddleware, (req, res) => {
    const db = req.userDb;
    const year = parseInt(req.body?.year, 10);

    if (!Number.isInteger(year) || year < 1900 || year > 2100) {
        return res.status(400).json({ error: 'Invalid base year' });
    }

    db.get("SELECT year, locked FROM base_year WHERE id = 1", [], (err, row) => {
        if (err) return res.status(500).json({ error: err.message });

        if (row && row.year !== year && row.locked) {
            return res.status(409).json({ error: 'Base year is locked' });
        }

        if (row && row.year === year) {
            return res.json({ message: 'Base year unchanged', year });
        }

        db.run("INSERT OR REPLACE INTO base_year (id, year, locked) VALUES (1, ?, 1)", [year], function (err2) {
            if (err2) return res.status(500).json({ error: err2.message });
            res.json({ message: 'Base year set', year });
        });
    });
});

