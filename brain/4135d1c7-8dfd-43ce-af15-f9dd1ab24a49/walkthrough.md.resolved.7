document.addEventListener('DOMContentLoaded', async () => {
    // 1. Get User
    const userStr = localStorage.getItem('ghg_user');
    if (!userStr) return;
    const user = JSON.parse(userStr);

    // 2. Fetch Data (Emissions & Goals)
    try {
        const [emissionsRes, goalsRes] = await Promise.all([
            fetch('/api/emissions', { headers: { 'X-User-Id': user.id } }),
            fetch('/api/goals', { headers: { 'X-User-Id': user.id } })
        ]);

        const emissions = await emissionsRes.json();
        const goals = await goalsRes.json();

        const currentYear = new Date().getFullYear();

        // Calculate Total Emissions for Current Year
        const totalEmissions = emissions
            .filter(r => r.year === currentYear)
            .reduce((sum, r) => sum + (r.co2e_total || (r.emissions ? r.emissions.totalCo2e : 0) || 0), 0);

        const totalTonnes = totalEmissions / 1000;

        // Get Goal for Current Year
        const goalRecord = goals.find(g => g.year === currentYear);
        const goalTarget = goalRecord ? goalRecord.target_emissions : null;

        // Generate Notifications
        const rawNotifications = [];

        // Notification: Goal Status
        if (goalTarget) {
            const percentage = (totalTonnes / goalTarget) * 100;

            if (percentage >= 100) {
                rawNotifications.push({
                    id: `goal-critical-${currentYear}`,
                    type: 'critical',
                    title: 'Goal Exceeded',
                    message: `You have exceeded your ${currentYear} emission goal of ${goalTarget} tCO2e. Current: ${totalTonnes.toFixed(1)} t.`,
                    time: 'Now'
                });
            } else if (percentage >= 80) {
                rawNotifications.push({
                    id: `goal-warning-${currentYear}`,
                    type: 'warning',
                    title: 'Approaching Goal Limit',
                    message: `You are at ${percentage.toFixed(0)}% of your emission goal.`,
                    time: 'Now'
                });
            }
        } else {
            rawNotifications.push({
                id: `goal-mission-${currentYear}`,
                type: 'info',
                title: 'Set a Goal',
                message: `No emission goal set for ${currentYear}. Set one to track progress.`,
                time: 'Now'
            });
        }

        // Notification: Custom Factors Info (New)
        rawNotifications.push({
            id: 'info-custom-factors',
            type: 'info',
            title: 'Custom Factors',
            message: 'You can add your own custom emission factors in the Manage Data section.',
            time: 'Tip'
        });

        // Filter Dismissed Notifications
        const dismissed = JSON.parse(localStorage.getItem('ghg_dismissed_notifications') || '[]');
        const activeNotifications = rawNotifications.filter(n => !dismissed.includes(n.id));

        // Render
        updateNotificationUI(activeNotifications);

    } catch (e) {
        console.error('Notification Logic Error', e);
    }

    // Toggle Logic
    const btn = document.getElementById('notification-btn');
    const dropdown = document.getElementById('notification-dropdown');

    if (btn && dropdown) {
        btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isHidden = dropdown.style.display === 'none';
            dropdown.style.display = isHidden ? 'block' : 'none';
        });

        document.addEventListener('click', (e) => {
            if (!btn.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.style.display = 'none';
            }
        });
    }
});

function updateNotificationUI(notifications) {
    const badge = document.getElementById('notification-badge');
    const list = document.getElementById('notification-list');

    if (!list) return;

    list.innerHTML = '';

    if (notifications.length > 0) {
        // Show Badge
        if (badge) badge.style.display = 'block';

        notifications.forEach(n => {
            const item = document.createElement('div');
            item.style.padding = '15px';
            item.style.borderBottom = '1px solid rgba(255,255,255,0.05)';
            item.style.display = 'flex';
            item.style.gap = '12px';
            item.style.alignItems = 'start';
            item.style.position = 'relative'; // For close button positioning

            let color = '#3b82f6'; // info
            let icon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>`;

            if (n.type === 'critical') {
                color = '#ef4444';
                icon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="2"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>`;
            } else if (n.type === 'warning') {
                color = '#f59e0b';
                icon = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>`;
            }

            item.innerHTML = `
                <div style="margin-top:2px;">${icon}</div>
                <div style="flex: 1;">
                    <div style="color: var(--text-primary); font-size: 0.9rem; font-weight: 500; margin-bottom: 2px; padding-right: 20px;">${n.title}</div>
                    <div style="color: var(--text-secondary); font-size: 0.85rem; line-height: 1.4;">${n.message}</div>
                    <div style="color: rgba(255,255,255,0.3); font-size: 0.75rem; margin-top: 5px;">${n.time}</div>
                </div>
                <button class="dismiss-btn" data-id="${n.id}" style="background:none; border:none; color:rgba(255,255,255,0.4); cursor:pointer; padding:2px; position:absolute; top:12px; right:12px; transition:color 0.2s;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            `;
            list.appendChild(item);
        });

        // Add Listeners to Dismiss Buttons
        document.querySelectorAll('.dismiss-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation(); // Prevent closing dropdown
                const id = btn.getAttribute('data-id');
                dismissNotification(id);
                // Remove from UI immediately
                const item = btn.closest('div[style*="position: relative"]'); // Robust selector
                if (item) item.remove();

                // Update Badge if list empty
                if (list.children.length === 0) {
                    if (badge) badge.style.display = 'none';
                    list.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-secondary); font-size: 0.9rem;">No new notifications</div>';
                }
            });

            // Hover effect
            btn.addEventListener('mouseover', () => btn.style.color = 'var(--text-primary)');
            btn.addEventListener('mouseout', () => btn.style.color = 'rgba(255,255,255,0.4)');
        });

    } else {
        if (badge) badge.style.display = 'none';
        list.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-secondary); font-size: 0.9rem;">No new notifications</div>';
    }
}

function dismissNotification(id) {
    const dismissed = JSON.parse(localStorage.getItem('ghg_dismissed_notifications') || '[]');
    if (!dismissed.includes(id)) {
        dismissed.push(id);
        localStorage.setItem('ghg_dismissed_notifications', JSON.stringify(dismissed));
        console.log(`Dismissed notification: ${id}`);
    }
}
