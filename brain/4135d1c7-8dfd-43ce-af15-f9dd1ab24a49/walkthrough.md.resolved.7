            // Migration: Add new columns if they don't exist
            const columns = ['email', 'jobTitle', 'department', 'phone', 'location', 'bio', 'profilePic', 'consolidationApproach'];
            columns.forEach(col => {
                usersDb.run(`ALTER TABLE users ADD COLUMN ${col} TEXT`, (err) => {
