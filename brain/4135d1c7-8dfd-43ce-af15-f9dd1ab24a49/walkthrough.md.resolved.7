    const { currentPassword, newPassword } = req.body;

    if (req.user.id != userId) {
        return res.status(403).json({ message: 'Unauthorized password update' });
    }

    usersDb.get('SELECT password FROM users WHERE id = ?', [userId], (err, row) => {
        if (err || !row) return res.status(500).json({ message: 'User not found' });

        const isMatch = bcrypt.compareSync(currentPassword, row.password);
        if (!isMatch) return res.status(401).json({ message: 'Current password incorrect' });

        const hashed = bcrypt.hashSync(newPassword, 10);
        usersDb.run('UPDATE users SET password = ? WHERE id = ?', [hashed, userId], (err) => {
            if (err) return res.status(500).json({ message: 'Error updating password' });
            res.json({ message: 'Password updated successfully' });
        });
    });
});

