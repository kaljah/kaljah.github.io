app.post('/login', (req, res) => {
    const { name, password } = req.body;
    // console.log(`Login attempt for: ${name}`); // DEBUG // Reduced logs

    if (!name || !password) {
        return res.status(400).json({ message: 'Name and password are required' });
    }

    usersDb.get(`SELECT * FROM users WHERE fullName = ?`, [name], (err, user) => {
        if (err) {
            console.error('DB Error fetching user:', err); // DEBUG
            return res.status(500).json({ message: 'Database error' });
        }

        if (!user) {
            console.log(`User not found: ${name}`); // DEBUG
            return res.status(401).json({ message: 'Account not found. Please check your username or register a new account.' });
        }

        // console.log(`User found: ${user.fullName}, checking password...`); // DEBUG
        const isMatch = bcrypt.compareSync(password, user.password);

        if (!isMatch) {
            console.log(`Password mismatch for user: ${name}`); // DEBUG
            return res.status(401).json({ message: 'Invalid credentials' });
        }

        // console.log(`Login successful for: ${name}`); // DEBUG
        res.json({
            message: 'Login successful',
            user: {
                id: user.id,
                fullName: user.fullName,
                orgName: user.orgName,
                sector: user.sector,
                email: user.email,
                jobTitle: user.jobTitle,
                department: user.department,
                phone: user.phone,
                location: user.location,
                bio: user.bio,
                profilePic: user.profilePic,
                consolidationApproach: user.consolidationApproach || 'Control'
            }
        });
    });
});

