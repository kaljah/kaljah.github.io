app.post('/api/emissions', authMiddleware, (req, res) => {
    const data = req.body;

    // Support both nested emissions object and flat structure
    const emissions = data.emissions || {};
    const co2 = data.co2_emissions ?? emissions.co2 ?? 0;
    const ch4 = data.ch4_emissions ?? emissions.ch4 ?? 0;
    const n2o = data.n2o_emissions ?? emissions.n2o ?? 0;
    const total = data.co2e_total ?? emissions.totalCo2e ?? 0;

    // Support factor extraction
    const ef_co2 = data.ef_used_co2 ?? data.factorData?.co2 ?? data.specificFactors?.co2Raw ?? 0;
    const ef_ch4 = data.ef_used_ch4 ?? data.factorData?.ch4 ?? data.specificFactors?.ch4Raw ?? 0;
    const ef_n2o = data.ef_used_n2o ?? data.factorData?.n2o ?? data.specificFactors?.n2oRaw ?? 0;

    // Standardize IDs and Names
    const recordId = data.id || data.record_id || `rec-${Date.now()}`;
    const company = data.companyName || data.company_name || req.user.orgName || 'Unknown Company';
    const groupName = data.group || data.group_name || 'Unassigned';
    const equipment = data.equipment || data.equipment_id || 'N/A';
    const process = data.process || data.process_type || 'other';
    const fuel = data.fuel || data.fuel_type || 'N/A';
    const source = data.factor_source || (data.isSpecific ? 'specific' : 'standard');

    const stmt = req.userDb.prepare(`INSERT INTO emissions (
        company_name, group_name, equipment_id, process_type, fuel_type, factor_source,
        quantity, unit, co2_emissions, ch4_emissions, n2o_emissions, co2e_total,
        ef_used_co2, ef_used_ch4, ef_used_n2o, year, month, record_id, facility_id,
        uncertainty, status, co2_biogenic
    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`);

    stmt.run(
        company,
        groupName,
        equipment,
        process,
        fuel,
        source,
        data.amount || data.quantity || 0,
        data.unit || 'unit',
        co2,
        ch4,
        n2o,
        total,
        ef_co2,
        ef_ch4,
        ef_n2o,
        data.year,
        data.month,
        recordId,
        data.facilityId || null,
        data.uncertainty || 0,
        data.status || 'Verified',
        data.co2_biogenic || 0,
        (err) => {
            if (err) {
                console.error('Error inserting emission:', err);
                return res.status(500).json({ message: 'Error saving record' });
            }

            // Audit Log
            req.userDb.run(`INSERT INTO audit_log (action, record_id, user_name, details) VALUES (?, ?, ?, ?)`,
                ['create', recordId, req.user.fullName, `Added ${process} record for ${groupName}`]
            );

            res.status(201).json({ message: 'Record saved', id: recordId });
        });
    stmt.finalize();
});

