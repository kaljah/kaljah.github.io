// Master database for user authentication
let usersDb;

// Cache for user databases
const userDbCache = {};

// Initialize Master Users Database
function initUsersDatabase() {
    usersDb = new sqlite3.Database(USERS_DB_PATH, (err) => {
        if (err) {
            console.error('Error opening users database:', err.message);
        } else {
            console.log('Connected to the users database.');
            createUsersTable();
        }
    });
}

function createUsersTable() {
    usersDb.run(`CREATE TABLE IF NOT EXISTS users (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        fullName TEXT NOT NULL,
        orgName TEXT NOT NULL,
        password TEXT NOT NULL,
        sector TEXT NOT NULL,
        email TEXT,
        jobTitle TEXT,
        department TEXT,
        phone TEXT,
        location TEXT,
        bio TEXT,
        profilePic TEXT,
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP
    )`, (err) => {
        if (err) {
            console.error('Error creating users table:', err.message);
        } else {
            console.log('Users table ready.');
            // Migration: Add new columns if they don't exist
            const columns = ['email', 'jobTitle', 'department', 'phone', 'location', 'bio', 'profilePic', 'consolidationApproach'];
            columns.forEach(col => {
                usersDb.run(`ALTER TABLE users ADD COLUMN ${col} TEXT`, (err) => {
                    // Ignore error if column already exists
                });
            });
        }
    });
}

// Get or create user-specific database
function getUserDatabase(userId, username) {
    // Check cache first
    if (userDbCache[userId]) {
        return userDbCache[userId];
    }

    // Sanitize username for filename (remove spaces and special characters)
    const sanitizedUsername = username.replace(/[^a-zA-Z0-9_-]/g, '_');
    const dbPath = path.join(USER_DBS_DIR, `${sanitizedUsername}.db`);

    const db = new sqlite3.Database(dbPath, (err) => {
        if (err) {
            console.error(`Error opening database for user ${username}:`, err.message);
        } else {
            console.log(`Connected to database for user ${username} (${sanitizedUsername}.db)`);
            initUserSchema(db);
        }
    });

    userDbCache[userId] = db;
    return db;
}

// Initialize schema for user-specific database
function initUserSchema(db) {
    db.serialize(() => {
        // Emissions Table with ISO 14064 fields
        db.run(`CREATE TABLE IF NOT EXISTS emissions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            record_id TEXT,
            year INTEGER,
            month INTEGER,
            company_name TEXT,
            group_name TEXT,
            equipment_id TEXT,
            process_type TEXT,
            fuel_type TEXT,
            quantity REAL,
            unit TEXT,
            factor_source TEXT,
            ef_used_co2 REAL,
            ef_used_ch4 REAL,
            ef_used_n2o REAL,
            co2_emissions REAL,
            ch4_emissions REAL,
            n2o_emissions REAL,
            co2e_total REAL,
            timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
            uncertainty REAL DEFAULT 0,
            status TEXT DEFAULT 'Verified',
            co2_biogenic REAL DEFAULT 0
        )`);

        db.run(`CREATE TABLE IF NOT EXISTS custom_factors (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT,
            co2_factor REAL,
            ch4_factor REAL,
            n2o_factor REAL,
            unit TEXT,
            hhv_factor REAL,
            usage TEXT,
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
            uncertainty REAL DEFAULT 0
        )`);

        // Migration: Add hhv_factor and usage if they don't exist
        db.run(`ALTER TABLE custom_factors ADD COLUMN hhv_factor REAL`, (err) => { });
        db.run(`ALTER TABLE custom_factors ADD COLUMN usage TEXT`, (err) => { });

        // MOVED: ISO 14064 Migrations
        db.run(`ALTER TABLE custom_factors ADD COLUMN uncertainty REAL`, (err) => { });
        db.run(`ALTER TABLE emissions ADD COLUMN uncertainty REAL DEFAULT 0`, (err) => { });
        db.run(`ALTER TABLE emissions ADD COLUMN status TEXT DEFAULT 'Verified'`, (err) => { });
        db.run(`ALTER TABLE emissions ADD COLUMN co2_biogenic REAL DEFAULT 0`, (err) => { });

        // Goals Table
        db.run(`CREATE TABLE IF NOT EXISTS goals (
            year INTEGER PRIMARY KEY,
            target_amount REAL,
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP
        )`);

        db.run(`CREATE TABLE IF NOT EXISTS base_year (
            id INTEGER PRIMARY KEY CHECK (id = 1),
            year INTEGER NOT NULL,
            locked INTEGER NOT NULL DEFAULT 1,
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP
        )`);

        // Facilities Table
        db.run(`CREATE TABLE IF NOT EXISTS facilities (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT,
            location TEXT,
