            optionsHtml += facilities.map(f => `<div class="dropdown-option" data-value="${f.id}">${f.name}</div>`).join('');

            if (facilityOptionsContainer) {
                facilityOptionsContainer.innerHTML = optionsHtml;

                // Add click listeners to new options
                const options = facilityOptionsContainer.querySelectorAll('.dropdown-option');
                options.forEach(option => {
                    option.addEventListener('click', async () => {
                        const val = option.getAttribute('data-value');
                        const name = option.textContent;
                        currentFacilityId = val;

                        // Update UI
                        options.forEach(opt => opt.classList.remove('selected'));
                        option.classList.add('selected');
                        selectedFacilityText.textContent = name;
                        facilityDropdown.classList.remove('active');

                        // Update Hero-Card Badge
                        const badge = document.getElementById('selected-facility-badge');
                        if (badge) badge.textContent = name;

                        // Reload Data
