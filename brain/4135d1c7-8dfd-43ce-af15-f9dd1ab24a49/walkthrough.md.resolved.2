    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const userStr = localStorage.getItem('ghg_user');
            const user = userStr ? JSON.parse(userStr) : null;
            if (!user) window.location.href = 'index.html';

            // Load Recalculation History
            const historyBody = document.getElementById('recalculation-history-body');
            try {
                const res = await fetch('/api/base-year-recalculation', {
                    headers: { 'X-User-Id': user.id }
                });
                const history = await res.json();

                if (history && history.length > 0) {
                    historyBody.innerHTML = history.map(h => `
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <td style="padding: 12px 15px;">${new Date(h.timestamp).toLocaleDateString()}</td>
                            <td style="padding: 12px 15px;">${h.old_year || 'Initial'}</td>
                            <td style="padding: 12px 15px; color: var(--accent-color); font-weight: 600;">${h.new_year}</td>
                            <td style="padding: 12px 15px; color: #d1d5db; max-width: 300px; white-space: normal;">${h.reason}</td>
                            <td style="padding: 12px 15px;">${h.user_name}</td>
                        </tr>
                    `).join('');
                } else {
                    historyBody.innerHTML = '<tr><td colspan="5" style="padding: 20px; text-align: center; color: #9ca3af;">No recalculation history found.</td></tr>';
                }
            } catch (e) {
                console.error('Failed to load recalculation history', e);
                historyBody.innerHTML = '<tr><td colspan="5" style="padding: 20px; text-align: center; color: #ef4444;">Error loading history.</td></tr>';
            }

            // Verification Report Event
            const vBtn = document.getElementById('generate-verification-btn');
            if (vBtn) {
                vBtn.addEventListener('click', () => {
                    if (window.generateVerificationReport) {
                        window.generateVerificationReport();
                    } else {
                        toastError('Report generator not ready');
                    }
                });
            }
        });
    </script>
