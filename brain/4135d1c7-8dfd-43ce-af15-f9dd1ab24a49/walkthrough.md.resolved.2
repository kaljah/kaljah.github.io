app.post('/api/base-year-recalculation', authMiddleware, (req, res) => {
    const db = req.userDb;
    const { year, reason } = req.body;
    const newYear = parseInt(year, 10);

    if (!Number.isInteger(newYear) || newYear < 1900 || newYear > 2100) {
        return res.status(400).json({ error: 'Invalid year' });
    }

    // Get current base year for the log
    db.get("SELECT year FROM base_year WHERE id = 1", [], (err, row) => {
        if (err) return res.status(500).json({ error: err.message });
        const oldYear = row ? row.year : null;

        db.serialize(() => {
            // Update base year
            db.run("INSERT OR REPLACE INTO base_year (id, year, locked) VALUES (1, ?, 1)", [newYear]);

            // Add to recalculation log
            db.run("INSERT INTO recalculation_log (old_year, new_year, reason, user_name) VALUES (?, ?, ?, ?)",
                [oldYear, newYear, reason || 'No reason provided', req.user.fullName],
                function (err2) {
                    if (err2) return res.status(500).json({ error: err2.message });

                    // Also add to general audit log
                    db.run("INSERT INTO audit_log (action, record_id, user_name, details) VALUES (?, ?, ?, ?)",
                        ['base_year_change', 'BY-1', req.user.fullName, `Base year changed from ${oldYear} to ${newYear}. Reason: ${reason}`]
                    );

                    res.json({ message: 'Base year recalculated and logged', year: newYear });
                }
            );
        });
    });
});

