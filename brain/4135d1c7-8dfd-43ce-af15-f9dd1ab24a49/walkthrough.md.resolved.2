function createUsersTable() {
    usersDb.run(`CREATE TABLE IF NOT EXISTS users (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        fullName TEXT NOT NULL,
        orgName TEXT NOT NULL,
        password TEXT NOT NULL,
        sector TEXT NOT NULL,
        email TEXT,
        jobTitle TEXT,
        department TEXT,
        phone TEXT,
        location TEXT,
