    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="toast.js"></script>
    <style>
        /* Compliance specific styles */
        .compliance-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .status-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 24px;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .status-card:hover {
            transform: translateY(-2px);
            background: rgba(255, 255, 255, 0.04);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .status-header {
            display: flex;
            justify-content: space-between;
            align-items: start;
            margin-bottom: 20px;
        }

        .status-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
        }

        .score-large {
            font-size: 2.5rem;
            font-weight: 700;
            color: #fff;
            line-height: 1;
            margin-bottom: 8px;
        }

        .score-label {
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        .audit-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .audit-item {
            display: flex;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 0.9rem;
            color: var(--text-secondary);
        }

        .audit-item:last-child {
            border-bottom: none;
        }

        .audit-icon {
            flex-shrink: 0;
            margin-top: 2px;
        }

        .finding-card {
            grid-column: span 3;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 24px;
        }

        .finding-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
        }

        @media (max-width: 1024px) {
            .compliance-grid {
                grid-template-columns: 1fr;
                /* Stack on smaller screens */
            }

            .finding-card {
                grid-column: span 1;
            }

            .finding-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

