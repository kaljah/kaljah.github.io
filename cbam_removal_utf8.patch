+            ws4.cell(row=row_curr, column=5, value=round(td_total, 2))
+            ws4.cell(row=row_curr, column=6, value=f"{var_pct:+.2f}%" if td_total > 0 else "N/A")
+            ws4.cell(row=row_curr, column=7, value=f"┬▒{thresh}%")
