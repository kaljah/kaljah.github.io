+    u = str(unit).strip().lower()
+    v = float(val)
+    if u in ['c', 'celsius', 'degc', '┬░c']:
+        return (v * 9.0 / 5.0) + 32.0
+    elif u in ['f', 'fahrenheit', 'degf', '┬░f']:
+        return v
+    elif u in ['k', 'kelvin']:
