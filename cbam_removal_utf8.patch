+    elif u in ['f', 'fahrenheit', 'degf', '┬░f']:
+        return (v - 32.0) * 5.0 / 9.0 + 273.15
+    elif u in ['r', 'rankine', 'degr', '┬░r']:
+        return v * 5.0 / 9.0
+    elif u in ['k', 'kelvin']:
+        return v
+    return v + 273.15
